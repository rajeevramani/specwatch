{
  "name": "@agentready/scoring",
  "version": "0.0.0",
  "private": true,
  "description": "Shared JAIRF scoring (scoreSpec, extractRuntimeSignals, types) vendored from agent-ready-score, single source of truth for the calibration harness and specwatch.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "node ../../scripts/sync-scoring.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "vitest": "^3.0.0"
  }
}
